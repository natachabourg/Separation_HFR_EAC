function [covaruv,umean,vmean] = covariancetemp(u)
%%% permet de calculer la variance temporelle
%%% d'une matrice (temps*lat*lon)

[dimt,dimy,dimx]=size(u);

for x=1:dimx
    for y=1:dimy
        umean(y,x)=sum(u(:,y,x))/dimt;
    end
end
for x=1:dimx
    for y=1:dimy
        varu(y,x)=sum((u(:,y,x)-umean(y,x)).^2);
    end
end
varu=varu/(dimt-1);

return
end